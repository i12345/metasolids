{
  "name": "metasolids",
  "version": "1.0.0",
  "description": "Metasolid meshing algorithms",
  "types": "dist/types/index.d.ts",
  "main": "dist/index.js",
  "type": "module",
  "exports": {
    "types": "./dist/types/index.d.ts",
    "import": "./dist/index.js"
  },
  "scripts": {
    "build": "npm run build:release",
    "build:release": "npm run build:clean && npm run build:tsc:release",
    "build:debug": "npm run build:clean && npm run build:tsc:debug",
    "build:clean": "rm -rf dist",
    "build:tsc:release": "tsc -p tsconfig.json",
    "build:tsc:debug": "tsc -p tsconfig.dbg.json",
    "pretest": "npm run clean:textures && npm run build:debug",
    "clean:textures": "rm -rf output-textures && mkdir output-textures",
    "test": "mocha -u tdd --colors -p src/tsconfig.json 'dist/**/*.spec.js'"
  },
  "keywords": [
    "dual-contour",
    "marching-cubes",
    "surface-nets",
    "metasolids",
    "isosurface",
    "textures"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@tensorflow/tfjs-node": "^4.12.0",
    "@types/chai": "^4.3.9",
    "@types/culori": "^2.0.3",
    "@types/jsdom-global": "^3.0.6",
    "@types/mocha": "^10.0.3",
    "@types/ronomon__hash-table": "^2.0.4",
    "@types/save-pixels": "^2.3.3",
    "canvas": "^2.11.2",
    "chai": "^4.3.10",
    "gl": "^6.0.2",
    "jsdom-global": "^3.0.2",
    "mocha": "^10.2.0",
    "ndarray": "^1.0.19",
    "node-canvas-webgl": "^0.3.0",
    "reflect-metadata": "^0.1.13",
    "save-pixels": "^2.3.6",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "@ronomon/hash-table": "^2.0.8",
    "@tensorflow/tfjs": "^4.12.0",
    "byte-rw": "^1.2.2",
    "curve-interpolator-vectorized": "^3.3.7",
    "playcanvas-extended": "^1.66.2-dev",
    "playcanvas-extended-serializer": "^1.0.0",
    "simple-typed-serialization": "^1.1.8",
    "type-namespace": "^1.1.0",
    "vectorized-functions": "^1.2.1",
    "xatlasjs-esm": "^0.1.3"
  }
}
